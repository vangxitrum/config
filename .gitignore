# Per-machine overrides (templates are committed as *.local.example)
*.local
!*.local.example

# Backups made by install.sh when it replaces a real file
*.bak.*

# Runtime/generated state inside linked config dirs
config/tmux/plugins/
__pycache__/
*.pyc

# tmuxinator layouts are per-machine: new ones stay local. The shared layouts
# already tracked are unaffected; add a new shared one with `git add -f`.
config/tmuxinator/*

# dadbod-ui: saved queries are shared, but connections added with `A` store
# plain URLs (passwords included). Connections come from ~/.pg_service.conf.
config/db_ui/connections.json
